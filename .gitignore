# ── 运行时数据（每台机器各有一份，绝不入库）──
config.json
state/
logs/
data/
memory/
记忆库/
qq-workspace/
docs/testing/
docs/work-progress.md
docs/full-verification-*.md
docs/update-program.md
# thinking-effort 插件启动时写在 cwd 的小文件（桌面宿主会带出来）
thinking-effort-loaded.json

# 本机的模型路由补丁（含私有中转地址，仓库里只放 headless-model.yml 模板）
patches/*.local.yml

# DSH 技能文档：里面写着本机的记忆库/工程绝对路径，只在本机加载，不进仓库
skills/

# ── 第三方运行时 / 依赖 ──
napcat/
node_modules/
vendor/

# ── 构建产物 ──
dist/
*.zip
*.exe
*.msi

# ── 环境与密钥 ──
.env
.env.local
.env.*.local
*.pem
*.key
.credentials.yaml

