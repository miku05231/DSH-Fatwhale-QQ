# ============================================================
#  docker compose 用的环境变量模板
#  复制成 .env 再改：cp .env.example .env
# ============================================================

# 聊天白名单，多个 QQ 号用英文逗号分隔；留空时拒绝所有人
OWNER_QQ=
# 电脑工具管理员，须显式配置；聊天白名单不会自动获得电脑权限
ADMIN_QQ_IDS=

# 桥接去连 NapCat 的 OneBot 地址
#   · 用 compose 里的 napcat 服务：ws://napcat:3001
#   · NapCat 在宿主机上：ws://host.docker.internal:3001
ONE_BOT_URL=ws://napcat:3001
# 和 NapCat 里配的 token 一致；没设就留空
ONE_BOT_TOKEN=

# ---- DSH（真正回话的执行端）----
# 镜像里没装 DSH；挂载 Linux Alpine 兼容的运行时，见 docs/Docker部署.md。
# npm --prefix /opt/dsh 安装后的入口：
#   DSH_COMMAND=/opt/dsh/node_modules/@deepseek-ai/dsh/lib/bin.js
# 这里填单个可执行文件或 JS 路径，不要加 node 前缀。
DSH_COMMAND=dsh
DSH_PROFILE=headless
DSH_PATCH=
DSH_CWD=/app/qq-workspace
DSH_TIMEOUT_MS=300000
# DSH 会话、profiles 与凭据目录，compose 使用命名卷 dsh-home
DSH_HOME=/home/bridge/.dsh
# 可选：容器内只读凭据源；启动时复制到 DSH_HOME 并设置为 600
# 须另加只读挂载，见文档中的 compose.dsh.yml
DSH_CREDENTIALS_FILE=
# 也可用官方 API key；与凭据文件任选其一，真实值只写本机 .env
DEEPSEEK_API_KEY=

# ---- 行为 ----
ALLOW_GROUPS=true
WAKE_WORD=
MEMORY_ROOT=/app/memory
REFLECT_DAILY=true
REFLECT_TIME=04:00

# ---- 端口（仅改宿主映射端口，容器控制台固定 5830）----
CONSOLE_PORT=5830
NAPCAT_WEBUI_PORT=6099

# ---- NapCat ----
NAPCAT_UID=1000
NAPCAT_GID=1000
NAPCAT_MODE=ws
NAPCAT_WEBUI_TOKEN=qqdsh

TZ=Asia/Shanghai
