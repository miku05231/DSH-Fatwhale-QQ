# ============================================================
#  docker compose 用的环境变量模板
#  复制成 .env 再改：cp .env.example .env
# ============================================================

# 必填：你的 QQ 号（只有它能指挥机器人；多个用英文逗号分隔，代码只取第一个）
OWNER_QQ=

# 桥接去连 NapCat 的 OneBot 地址
#   · 用 compose 里的 napcat 服务：ws://napcat:3001
#   · NapCat 在宿主机上：ws://host.docker.internal:3001
ONE_BOT_URL=ws://napcat:3001
# 和 NapCat 里配的 token 一致；没设就留空
ONE_BOT_TOKEN=

# ---- DSH（真正回话的执行端）----
# 镜像里没装 DSH。要么把宿主机的 DSH 挂进 /opt/dsh 并写成：
#   DSH_COMMAND=node /opt/dsh/lib/bin.js
# 要么自己在这个镜像上再装一层。
DSH_COMMAND=dsh
DSH_PROFILE=headless
DSH_PATCH=
DSH_CWD=/app/qq-workspace
DSH_TIMEOUT_MS=300000

# ---- 行为 ----
ALLOW_GROUPS=true
WAKE_WORD=
MEMORY_ROOT=/app/memory
REFLECT_DAILY=true
REFLECT_TIME=04:00

# ---- 端口 ----
CONSOLE_PORT=5830
NAPCAT_WEBUI_PORT=6099

# ---- NapCat ----
NAPCAT_UID=1000
NAPCAT_GID=1000
NAPCAT_MODE=ws
NAPCAT_WEBUI_TOKEN=qqdsh

TZ=Asia/Shanghai
