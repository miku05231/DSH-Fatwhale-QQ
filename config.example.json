{
  "onebot": {
    "url": "ws://127.0.0.1:3001",
    "accessToken": ""
  },
  "dsh": {
    "command": "dsh",
    "profile": "headless",
    "patchPath": "patches/example-headless-model.yml",
    "cwd": "qq-workspace",
    "timeoutMs": 300000,
    "permissionMode": "danger-full-access"
  },
  "persona": {
    "enabled": true,
    "path": "qq-workspace/AGENTS.md",
    "maxChars": 8000,
    "dir": "state/personas",
    "active": ""
  },
  "security": {
    "allowFrom": [
      1000000002
    ],
    "allowGroups": true,
    "allowGroupMembers": true,
    "allowGroupIds": [
      200000001
    ],
    "rateLimitPerMinute": 10,
    "maxChars": 4000
  },
  "behavior": {
    "queuedNotice": "收到，马上回复。",
    "maxReplyChunk": 1200,
    "showErrors": true,
    "wakeWord": "",
    "wakeWordMatch": "contains",
    "groupContextCount": 40
  },
  "groupMemory": {
    "limit": 300
  },
  "memory": {
    "enabled": true,
    "root": "记忆库",
    "capture": true,
    "reflectEvery": 20,
    "maxInjectChars": 1200,
    "reflectDaily": true,
    "reflectTime": "04:00",
    "reflectForce": true,
    "reflectDays": 3,
    "reflectBackup": true,
    "reflectCatchUp": true
  },
  "stickers": {
    "enabled": true,
    "root": "state/stickers",
    "autoCollect": true,
    "autoTag": true,
    "maxBytes": 5242880,
    "minBytes": 200,
    "maxPerMessage": 3,
    "perMinute": 20
  },
  "plugins": {
    "enabled": true,
    "dir": "src/plugins"
  },
  "logDir": "logs",
  "stateDir": "state"
}
